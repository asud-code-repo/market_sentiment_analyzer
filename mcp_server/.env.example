# Copy to .env for local testing (gitignored). When launched by Claude
# Desktop, these come from the "env" block in claude_desktop_config.json
# instead — see claude_desktop_config.example.json in this folder.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Absolute path to your local portfolio file (see local_state/portfolio.example.yaml).
# Never a path inside a networked/synced folder that isn't actually local-only.
PORTFOLIO_PATH=C:\Users\YOUR_USER\local_repo\market_sentiment_analyzer\local_state\portfolio.yaml

# Absolute path to your local BrokerageLink watchlist file (see
# local_state/brokeragelink_watchlist.example.yaml). Same local-only rule as above.
WATCHLIST_PATH=C:\Users\YOUR_USER\local_repo\market_sentiment_analyzer\local_state\brokeragelink_watchlist.yaml

# Absolute path to your local wave-deployment execution-state file (see
# local_state/wave_deployment_state.example.yaml). Same local-only rule as above.
WAVE_DEPLOYMENT_STATE_PATH=C:\Users\YOUR_USER\local_repo\market_sentiment_analyzer\local_state\wave_deployment_state.yaml

# Optional: absolute path to the deployment-instrument registry (see
# local_state/deployment_instruments.example.yaml). Defaults to
# deployment_instruments.yaml in the same folder as PORTFOLIO_PATH.
# DEPLOYMENT_INSTRUMENTS_PATH=C:\Users\YOUR_USER\local_repo\market_sentiment_analyzer\local_state\deployment_instruments.yaml

# Optional: absolute path to the local 401k exchange log (see
# local_state/exchange_log.example.yaml). Defaults to exchange_log.yaml in the
# same folder as PORTFOLIO_PATH. A missing file just means no exchanges yet.
# EXCHANGE_LOG_PATH=C:\Users\YOUR_USER\local_repo\market_sentiment_analyzer\local_state\exchange_log.yaml

# Optional: local cache for check_fund_filings (default: fund_filing_events.yaml
# next to PORTFOLIO_PATH), and the contact address SEC requires in the EDGAR
# User-Agent (same variable as ingestion; a generic placeholder is used if unset).
# FUND_FILING_EVENTS_PATH=C:\Users\YOUR_USER\local_repo\market_sentiment_analyzer\local_state\fund_filing_events.yaml
# SEC_EDGAR_CONTACT_EMAIL=you@example.com
