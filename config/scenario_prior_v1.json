{
 "name": "scenario_prior",
 "version": "v1",
 "horizon_trading_days": 63,
 "buckets": {
  "reference": "the S&P close on the run's as-of date (C0)",
  "crash": "lowest close on trading days 1..63 is at least 20% below C0",
  "bear": "lowest close on days 1..63 is 10% to under 20% below C0",
  "bull": "no close on days 1..63 is 10% or more below C0, and the day-63 close is at least 5% above C0",
  "base": "everything else"
 },
 "states": {
  "basis": "rule_engine/src/hazardScorecard.ts: score = drawdown from all-time high (%) + VIX / 5",
  "LOW": "score < 8.5",
  "TRANSITIONING": "8.5 <= score < 10",
  "HIGH": "score >= 10",
  "ALREADY_BREACHED": "drawdown >= 10% (band not scored)"
 },
 "tilt": {
  "levels": [
   "lower",
   "in_line",
   "higher"
  ],
  "step_pts": 5,
  "higher": "move min(5, bull+base) points from bull/base (in proportion to their prior sizes) to bear/crash (in proportion to their prior sizes; all to bear if both are 0)",
  "lower": "move min(5, bear+crash) points from bear/crash (in proportion) to bull/base (in proportion; all to base if both are 0)",
  "integer_allocation": "floor of each proportional share, then the remainder one point at a time by largest fractional part; ties in the order bull, base, bear, crash"
 },
